{
  "title": "template-test-1 - HTTP metrics",
  "uid": "template-test-1-http",
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "tags": ["template-test-1", "app"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Success rate (2xx) - overall",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=~\"template-test-1.*\", status=~\"2..\"}[5m])) / sum(rate(http_requests_total{namespace=~\"template-test-1.*\"}[5m]))",
          "legendFormat": "success rate"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by status code",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{namespace=~\"template-test-1.*\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p50 / p95 / p99 request latency",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=~\"template-test-1.*\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=~\"template-test-1.*\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=~\"template-test-1.*\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Success rate (2xx) by pod -- variant comparison",
      "description": "Split by pod, across all three dev deployment-strategy namespaces (Milestone 6: template-test-1-{rolling,bluegreen,canary}) -- pod-level detail within a variant. For a namespace-level side-by-side comparison instead, see the Progressive Delivery dashboard.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "expr": "sum by (pod) (rate(http_requests_total{namespace=~\"template-test-1.*\", status=~\"2..\"}[5m])) / sum by (pod) (rate(http_requests_total{namespace=~\"template-test-1.*\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error rate (5xx) by pod -- variant comparison",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum by (pod) (rate(http_requests_total{namespace=~\"template-test-1.*\", status=~\"5..\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
