# Copy to .env.local (gitignored, and denied to Claude -- see .claude/settings.json)
# and fill in real values. scripts/bootstrap.sh sources this automatically.
#
# Classic PAT (not fine-grained -- fine-grained PATs have no "Packages"
# permission at all, so GHCR auth requires classic). Scopes: repo,
# read:packages.
TF_VAR_github_username=
TF_VAR_github_token=
