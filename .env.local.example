# Copy to .env.local (gitignored, and denied to Claude -- see .claude/settings.json)
# and fill in real values. scripts/bootstrap.sh sources this automatically.
#
# Two separate tokens: fine-grained PATs have no "Packages" permission at
# all, so GHCR auth only works with a classic PAT.
TF_VAR_github_username=

# Fine-grained PAT, scoped to this repo only: Contents: Read-only.
# Used by Argo CD to read the private GitOps repo.
TF_VAR_github_token=

# Classic PAT, scope: read:packages only.
# Used by the Kind node to pull the private GHCR image.
TF_VAR_ghcr_token=
